// iKeyd DSL prototype for the current hotkeySKG profile.
// This file is the human-authored source; compile it to JSON with:
//   python tools/compile-ikeyd-dsl.py config/hotkeySKG.ikeyd config/hotkeySKG.behavior.generated.json

profile hotkeySKG {
    runtime = "AutoHotkey v1.1.16.05"
    executable_lines = 1714
    chord_window = 40ms
}

keymap S {
    // single-stroke mappings
    Q = "-"
    W = "ni"
    E = "ha"
    R = "`,"
    T = "ti"
    Y = "gu"
    U = "ba"
