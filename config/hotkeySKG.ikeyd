    combo BASE[2,2] + BASE[3,6] = "wa"
    combo BASE[2,2] + BASE[3,7] = "da"
    combo BASE[2,2] + BASE[3,8] = "pi"
    combo BASE[2,2] + BASE[3,9] = "po"
    combo BASE[2,2] + BASE[3,10] = "tye"
    combo BASE[1,8] + 1 = "xyu"
    combo BASE[1,8] + 2 = "bya"
    combo BASE[1,8] + 3 = "byu"
    combo BASE[1,8] + 4 = "byo"
    combo BASE[1,8] + BASE[1,1] = "hyu"
    combo BASE[1,8] + BASE[1,2] = "syu"
    combo BASE[1,8] + BASE[1,3] = "syo"
    combo BASE[1,8] + BASE[1,4] = "kyu"
    combo BASE[1,8] + BASE[1,5] = "tyu"
    combo BASE[1,8] + BASE[2,1] = "hyo"
    combo BASE[1,8] + BASE[2,4] = "kyo"
    combo BASE[1,8] + BASE[2,5] = "tyo"
    combo BASE[1,8] + BASE[3,1] = "hya"
    combo BASE[1,8] + BASE[3,3] = "sya"
    combo BASE[1,8] + BASE[3,4] = "kya"
    combo BASE[1,8] + BASE[3,5] = "tya"
    combo BASE[1,9] + 1 = "xyo"
    combo BASE[1,9] + 2 = "pya"
    combo BASE[1,9] + 3 = "pyu"
    combo BASE[1,9] + 4 = "pyo"
    combo BASE[1,9] + BASE[1,1] = "ryu"
    combo BASE[1,9] + BASE[1,2] = "zyu"
    combo BASE[1,9] + BASE[1,3] = "zyo"
    combo BASE[1,9] + BASE[1,4] = "gyu"
    combo BASE[1,9] + BASE[1,5] = "nyu"
    combo BASE[1,9] + BASE[2,1] = "ryo"
    combo BASE[1,9] + BASE[2,4] = "gyo"
    combo BASE[1,9] + BASE[2,5] = "nyo"
    combo BASE[1,9] + BASE[3,1] = "rya"
    combo BASE[1,9] + BASE[3,3] = "zya"
    combo BASE[1,9] + BASE[3,4] = "gya"
    combo BASE[1,9] + BASE[3,5] = "nya"
    combo BASE[2,8] + 1 = "xa"
    combo BASE[2,8] + 2 = "xi"
    combo BASE[2,8] + 3 = "xu"
    combo BASE[2,8] + 4 = "xe"
    combo BASE[2,8] + 5 = "xo"
    combo BASE[2,9] + 1 = "xya"
    combo BASE[2,9] + 2 = "mya"
    combo BASE[2,9] + 3 = "myu"
    combo BASE[2,9] + 4 = "myo"
    combo BASE[2,9] + 5 = "xwa"
    // Preserve the original lowercase spellings below for byte-for-byte JSON compatibility.
    combo BASE[2,10] + q = "myu"
    combo BASE[2,10] + w = "pyu"
    combo BASE[2,10] + e = "pyo"
    combo BASE[2,10] + r = "byu"
    combo BASE[2,10] + t = "dyu"
    combo BASE[2,10] + a = "myo"
    combo BASE[2,10] + f = "byo"
    combo BASE[2,10] + g = "dyo"
    combo BASE[2,10] + z = "mya"
    combo BASE[2,10] + c = "pya"
    combo BASE[2,10] + v = "bya"
    combo BASE[2,10] + b = "dya"
    combo i + x = "xya"
    combo o + x = "xyu"
    combo BASE[2,10] + x = "xyo"
    combo BASE[2,3] + BASE[1,11] = "who"
}

