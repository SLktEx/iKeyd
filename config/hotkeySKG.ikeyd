    combo BASE[2,3] + BASE[3,9] = "pu"
    combo BASE[2,3] + BASE[3,10] = "vu"
    combo BASE[2,9] + BASE[1,1] = "di"
    combo BASE[2,9] + BASE[1,2] = "me"
    combo BASE[2,9] + BASE[1,3] = "ke"
    combo BASE[2,9] + BASE[1,4] = "thi"
    combo BASE[2,9] + BASE[1,5] = "dhi"
    combo BASE[2,9] + BASE[2,1] = "wo"
    combo BASE[2,9] + BASE[2,2] = "sa"
    combo BASE[2,9] + BASE[2,3] = "o"
    combo BASE[2,9] + BASE[2,4] = "ri"
    combo BASE[2,9] + BASE[2,5] = "zu"
