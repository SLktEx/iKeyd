<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>iKeyd</AssemblyName>
    <RootNamespace>iKeyd.App</RootNamespace>
    <ProfileSource>$(MSBuildProjectDirectory)\..\..\config\hotkeySKG.behavior.json</ProfileSource>
    <GeneratedProfileSource>$(IntermediateOutputPath)GeneratedProfile.g.cs</GeneratedProfileSource>
    <ProfileCompilerAssembly>$(MSBuildProjectDirectory)\..\..\tools\iKeyd.ProfileCompiler\bin\$(Configuration)\net8.0\iKeyd.ProfileCompiler.dll</ProfileCompilerAssembly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../iKeyd.Core/iKeyd.Core.csproj" />
    <ProjectReference Include="../iKeyd.Profiles.HotkeySkg/iKeyd.Profiles.HotkeySkg.csproj" />
    <ProjectReference Include="../iKeyd.Windows/iKeyd.Windows.csproj" />
    <ProjectReference Include="../../tools/iKeyd.ProfileCompiler/iKeyd.ProfileCompiler.csproj"
                      ReferenceOutputAssembly="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="iKeyd.Windows.Tests" />
    <Compile Include="$(GeneratedProfileSource)" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateCompiledProfile"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences"
          Inputs="$(ProfileSource);$(ProfileCompilerAssembly)"
          Outputs="$(GeneratedProfileSource)">
    <Exec Command="dotnet &quot;$(ProfileCompilerAssembly)&quot; &quot;$(ProfileSource)&quot; &quot;$(GeneratedProfileSource)&quot;" />
  </Target>
</Project>
