<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>iKeyd</AssemblyName>
    <RootNamespace>iKeyd.App</RootNamespace>
    <ApplicationIcon>Assets\ikeyd.ico</ApplicationIcon>
    <ProfileSource>$(MSBuildProjectDirectory)\..\..\config\hotkeySKG.ikeyd</ProfileSource>
    <GeneratedProfileSource>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\GeneratedProfile.g.cs</GeneratedProfileSource>
    <GeneratedMouseProfileSource>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\GeneratedMouseProfile.g.cs</GeneratedMouseProfileSource>
    <DslCompilerAssembly>$(MSBuildProjectDirectory)\..\..\tools\iKeyd.DslCompiler\bin\$(Configuration)\net8.0\iKeyd.DslCompiler.dll</DslCompilerAssembly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../iKeyd.Core/iKeyd.Core.csproj" />
    <ProjectReference Include="../iKeyd.Profiles.HotkeySkg/iKeyd.Profiles.HotkeySkg.csproj" />
    <ProjectReference Include="../iKeyd.Windows/iKeyd.Windows.csproj" />
    <ProjectReference Include="../../tools/iKeyd.DslCompiler/iKeyd.DslCompiler.csproj"
                      ReferenceOutputAssembly="false"
                      SetConfiguration="Configuration=$(Configuration)"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="iKeyd.Windows.Tests" />
    <Compile Include="$(GeneratedProfileSource)" Visible="false" />
    <Compile Include="$(GeneratedMouseProfileSource)" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateCompiledProfiles"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences"
          Inputs="$(ProfileSource);$(DslCompilerAssembly)"
          Outputs="$(GeneratedProfileSource);$(GeneratedMouseProfileSource)">
    <Exec Command="dotnet &quot;$(DslCompilerAssembly)&quot; &quot;$(ProfileSource)&quot; &quot;$(GeneratedProfileSource)&quot; &quot;$(GeneratedMouseProfileSource)&quot;" />
  </Target>
</Project>
