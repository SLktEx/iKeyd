{
  "id": "send-event-m-comma-space",
  "description": "M+Comma emits Space down/up through withFuncKey.",
  "initialState": { "mode": "S", "ime": "off", "layers": ["M"] },
  "input": [
    { "atMs": 10, "kind": "keyDown", "key": "Comma" },
    { "atMs": 20, "kind": "keyUp", "key": "Comma" }
  ],
  "expected": {
    "events": [
      { "kind": "keyDown", "key": "Space" },
      { "kind": "keyUp", "key": "Space" }
    ]
  },
  "tags": ["legacy", "send", "send-event-diff", "hosted-windows"]
}
