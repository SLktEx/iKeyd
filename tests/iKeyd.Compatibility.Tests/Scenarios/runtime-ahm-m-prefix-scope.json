      { "kind": "keyUp", "key": "ALT" },
      { "kind": "keyDown", "key": "SHIFT" },
      { "kind": "keyDown", "key": "END" },
      { "kind": "keyUp", "key": "END" },
      { "kind": "keyUp", "key": "SHIFT" }
