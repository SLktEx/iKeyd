    { "atMs": 30, "kind": "keyUp", "key": "KANA" },
    { "atMs": 40, "kind": "keyUp", "key": "ALT" },
    { "atMs": 60, "kind": "keyDown", "key": "CONVERT" },
    { "atMs": 80, "kind": "keyDown", "key": "NONCONVERT" },
    { "atMs": 100, "kind": "keyDown", "key": "M" },
    { "atMs": 120, "kind": "keyUp", "key": "M" },
    { "atMs": 140, "kind": "keyUp", "key": "NONCONVERT" },
    { "atMs": 160, "kind": "keyUp", "key": "CONVERT" }
