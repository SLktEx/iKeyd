{
  "id": "send-event-ms-j-control-shift-left",
  "description": "M then Space plus J emits legacy left Control+Shift+Left and releases modifiers in press order.",
  "initialState": { "mode": "S", "ime": "off", "layers": ["M", "S"] },
  "input": [
    { "atMs": 10, "kind": "keyDown", "key": "J" },
    { "atMs": 20, "kind": "keyUp", "key": "J" }
  ],
  "expected": {
    "events": [
      { "kind": "keyDown", "key": "VK_A2" },
      { "kind": "keyDown", "key": "VK_A0" },
      { "kind": "keyDown", "key": "Left" },
      { "kind": "keyUp", "key": "Left" },
      { "kind": "keyUp", "key": "VK_A2" },
      { "kind": "keyUp", "key": "VK_A0" }
    ]
  },
  "tags": ["legacy", "send", "send-event-diff", "hosted-windows"]
}
