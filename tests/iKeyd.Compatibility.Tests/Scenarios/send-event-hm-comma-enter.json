{
  "id": "send-event-hm-comma-enter",
  "description": "H then M plus Comma emits Enter down/up through withFuncKey.",
  "initialState": { "mode": "S", "ime": "off", "layers": ["H", "M"] },
  "input": [
    { "atMs": 10, "kind": "keyDown", "key": "Comma" },
    { "atMs": 20, "kind": "keyUp", "key": "Comma" }
  ],
  "expected": {
    "events": [
      { "kind": "keyDown", "key": "Enter" },
      { "kind": "keyUp", "key": "Enter" }
    ]
  },
  "tags": ["legacy", "send", "send-event-diff", "hosted-windows"]
}
