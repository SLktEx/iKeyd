{
  "id": "send-event-hm-j-control-left",
  "description": "H then M plus J emits Control+Left with legacy modifier ordering.",
  "initialState": { "mode": "S", "ime": "off", "layers": ["H", "M"] },
  "input": [
    { "atMs": 10, "kind": "keyDown", "key": "J" },
    { "atMs": 20, "kind": "keyUp", "key": "J" }
  ],
  "expected": {
    "events": [
      { "kind": "keyDown", "key": "Control" },
      { "kind": "keyDown", "key": "Left" },
      { "kind": "keyUp", "key": "Left" },
      { "kind": "keyUp", "key": "Control" }
    ]
  },
  "tags": ["legacy", "send", "send-event-diff", "hosted-windows"]
}
