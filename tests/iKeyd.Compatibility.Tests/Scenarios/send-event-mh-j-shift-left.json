{
  "id": "send-event-mh-j-shift-left",
  "description": "M then H plus J emits Shift+Left with legacy modifier ordering.",
  "initialState": { "mode": "S", "ime": "off", "layers": ["M", "H"] },
  "input": [
    { "atMs": 10, "kind": "keyDown", "key": "J" },
    { "atMs": 20, "kind": "keyUp", "key": "J" }
  ],
  "expected": {
    "events": [
      { "kind": "keyDown", "key": "Shift" },
      { "kind": "keyDown", "key": "Left" },
      { "kind": "keyUp", "key": "Left" },
      { "kind": "keyUp", "key": "Shift" }
    ]
  },
  "tags": ["legacy", "send", "send-event-diff", "hosted-windows"]
}
