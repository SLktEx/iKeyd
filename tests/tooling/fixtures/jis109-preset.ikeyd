profile jis109Preset {
    chord_window = 40ms
}

keyboard JIS109

// A compact logical subset can coexist with the full physical keyboard.
layout BASE {
    row Q W E
}

keymap S {
    POS.Ro = ro
    JIS109.Yen = yen
    combo POS.Muhenkan + POS.Ro = escape
    combo BASE[1,1] + BASE[1,2] = logical
}

keymap K {
    POS.Henkan = henkan
    JIS109.KatakanaHiragana = kana
    combo POS.Henkan + POS.Yen = other
}
